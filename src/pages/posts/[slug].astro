---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection, render } from 'astro:content';
import { SITE, catOf, fmtDate, url } from '../../site';

export async function getStaticPaths() {
  const posts = (await getCollection('posts')).sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf() || a.id.localeCompare(b.id));
  return posts.map((p, i) => ({
    params: { slug: p.id },
    props: { post: p, prev: posts[i - 1] ?? null, next: posts[i + 1] ?? null, all: posts },
  }));
}
const { post, prev, next, all } = Astro.props;
const { Content, headings } = await render(post);
const d = post.data;
const cat = catOf(d.category);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const related = [
  ...all.filter((p) => p.id !== post.id && p.data.category === d.category),
  ...all.filter((p) => p.id !== post.id && p.data.category !== d.category),
]
  .slice(0, 3);
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: d.title,
  description: d.description,
  datePublished: d.date.toISOString(),
  dateModified: d.date.toISOString(),
  inLanguage: 'ja',
  mainEntityOfPage: pageUrl,
  author: { '@type': 'Organization', name: SITE.name, url: new URL(url('about/'), Astro.site).href },
  publisher: { '@type': 'Organization', name: SITE.name },
  keywords: d.keyword,
};
const crumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: SITE.name, item: new URL(url('/'), Astro.site).href },
    { '@type': 'ListItem', position: 2, name: d.category, item: new URL(url(`category/${cat.slug}/`), Astro.site).href },
    { '@type': 'ListItem', position: 3, name: d.title },
  ],
};
const host = (s: string) => { try { return new URL(s).hostname.replace(/^www\d*\./, ''); } catch { return s; } };
---
<Base title={d.title} description={d.description} ogType="article" jsonld={[articleLd, crumbLd]}>
  <div class="wrap">
    <header class="post-head" style={`--cat:${cat.color}`}>
      <nav class="crumbs" aria-label="パンくずリスト">
        <a href={url('/')}>ホーム</a><span>/</span><a href={url(`category/${cat.slug}/`)}>{d.category}</a>
      </nav>
      <div class="post-tags">
        <a class="chip" href={url(`category/${cat.slug}/`)}>{d.category}</a>
        {d.hasAffiliate && <span class="pr">PR</span>}
      </div>
      <h1>{d.title}</h1>
      <p class="post-desc">{d.description}</p>
      <div class="post-meta">
        <time datetime={d.date.toISOString()}>{fmtDate(d.date)} 公開</time>
        <span class="verified">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 10.5l3.5 3.5 7.5-8" /></svg>
          数式は見本ファイルで検証済み
        </span>
      </div>
    </header>

    <div class="post-grid">
      <aside class="toc-side" aria-label="目次">
        {toc.length > 0 && (
          <nav class="toc">
            <p class="toc-title">目次</p>
            <ol>{toc.map((h) => <li class={`d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
          </nav>
        )}
        {d.sampleFile && (
          <a class="side-dl" href={url(`files/${d.sampleFile}`)} download>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12M7 10l5 5 5-5M4 20h16" /></svg>
            見本ファイルをダウンロード
          </a>
        )}
      </aside>

      <article class="post-main">
        {d.sampleFile && (
          <div class="dl-panel">
            <div class="dl-icon" aria-hidden="true">
              <svg viewBox="0 0 40 40"><rect x="4" y="2" width="28" height="36" rx="4" fill="#17683d" /><path d="M11 13l10 14M21 13L11 27" stroke="#fff" stroke-width="3" stroke-linecap="round" /><rect x="22" y="22" width="16" height="16" rx="8" fill="#fff" stroke="#17683d" stroke-width="2" /><path d="M30 26v7M27 30.5l3 3 3-3" stroke="#17683d" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </div>
            <div class="dl-text">
              <b>この記事の見本ファイル</b>
              <span>記事の数式と書式がすべて入っています。動きを確かめてから、自分の表に使ってください。</span>
            </div>
            <a class="btn" href={url(`files/${d.sampleFile}`)} download>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12M7 10l5 5 5-5M4 20h16" /></svg>
              {d.sampleFile}
            </a>
          </div>
        )}

        {toc.length > 0 && (
          <details class="toc toc-inline">
            <summary>目次</summary>
            <ol>{toc.map((h) => <li class={`d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
          </details>
        )}

        <div class="prose"><Content /></div>

        <section class="verify-box">
          <h2>この記事の確認方法</h2>
          <p>記事で紹介した数式は、見本ファイルに入れて表計算ソフトで実際に計算し、記事中の計算結果と一致することを確認してから掲載しています。お使いのExcelのバージョンによって使えない関数がある場合は、本文の代わりの数式をお試しください。</p>
          <p class="meta">誤りに気づいたら<a href={url('contact/')}>お問い合わせ</a>からお知らせください。</p>
        </section>

        <section class="sources">
          <h2>参考にした情報</h2>
          <ul>{d.sources.map((s) => <li><a href={s} rel="nofollow noopener" target="_blank"><span class="src-host">{host(s)}</span>{decodeURI(s).replace(/^https?:\/\/[^/]+/, '').slice(0, 90)}</a></li>)}</ul>
        </section>

        <nav class="pager" aria-label="前後の記事">
          {prev ? <a class="prev" href={url(`posts/${prev.id}/`)}><small>← 前の記事</small>{prev.data.title}</a> : <span></span>}
          {next ? <a class="next" href={url(`posts/${next.id}/`)}><small>次の記事 →</small>{next.data.title}</a> : <span></span>}
        </nav>
      </article>
    </div>

    {related.length > 0 && (
      <section>
        <div class="section-title"><h2>あわせて読みたいレシピ</h2></div>
        <div class="cards">{related.map((p) => <PostCard post={p} />)}</div>
      </section>
    )}
  </div>

  <script is:inline>
    document.querySelectorAll('.prose pre').forEach((pre) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'copy-btn';
      b.textContent = 'コピー';
      b.addEventListener('click', async () => {
        const text = pre.querySelector('code')?.innerText ?? pre.innerText;
        try { await navigator.clipboard.writeText(text.trim()); b.textContent = 'コピーしました'; b.classList.add('done'); }
        catch { b.textContent = '選択してコピーしてください'; }
        setTimeout(() => { b.textContent = 'コピー'; b.classList.remove('done'); }, 1800);
      });
      pre.appendChild(b);
    });
    const links = [...document.querySelectorAll('.toc-side .toc a')];
    if (links.length && 'IntersectionObserver' in window) {
      const map = new Map(links.map((a) => [decodeURIComponent(a.hash.slice(1)), a]));
      const io = new IntersectionObserver((es) => {
        es.forEach((e) => {
          if (e.isIntersecting) { links.forEach((l) => l.classList.remove('on')); map.get(e.target.id)?.classList.add('on'); }
        });
      }, { rootMargin: '-80px 0px -70% 0px' });
      document.querySelectorAll('.prose h2[id], .prose h3[id]').forEach((h) => io.observe(h));
    }
  </script>
</Base>

<style>
  .post-head { max-width: 820px; padding: 36px 0 8px; }
  .crumbs { font-size: .8rem; color: var(--faint); margin-bottom: 14px; display: flex; gap: 8px; flex-wrap: wrap; }
  .crumbs a { color: var(--muted); text-decoration: none; }
  .crumbs a:hover { color: var(--brand); }
  .post-tags { display: flex; gap: 8px; align-items: center; margin-bottom: 12px; }
  h1 { font-size: clamp(1.5rem, 3.6vw, 2.1rem); line-height: 1.45; margin: 0 0 14px; letter-spacing: .02em; }
  .post-desc { color: var(--muted); margin: 0 0 16px; font-size: .98rem; }
  .post-meta { display: flex; gap: 10px 18px; flex-wrap: wrap; align-items: center; font-size: .84rem; color: var(--faint); }
  .verified { display: inline-flex; align-items: center; gap: 6px; color: var(--brand); font-weight: 600; background: var(--brand-soft); padding: 2px 10px; border-radius: 999px; }
  .verified svg { width: 15px; height: 15px; }

  .post-grid { display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: 48px; margin-top: 28px; align-items: start; }
  .post-main { max-width: 760px; min-width: 0; }
  .toc-side { position: sticky; top: 84px; display: grid; gap: 16px; }
  .toc { font-size: .84rem; }
  .toc-title { font-weight: 700; font-size: .78rem; letter-spacing: .12em; color: var(--faint); margin: 0 0 8px; }
  .toc ol { list-style: none; margin: 0; padding: 0; border-left: 2px solid var(--line); }
  .toc li a { display: block; padding: 5px 0 5px 14px; margin-left: -2px; border-left: 2px solid transparent; color: var(--muted); text-decoration: none; line-height: 1.55; }
  .toc li.d3 a { padding-left: 26px; font-size: .8rem; }
  .toc li a:hover { color: var(--text); }
  .toc li a.on { color: var(--brand); border-left-color: var(--brand); font-weight: 600; }
  .side-dl { display: flex; align-items: center; gap: 8px; font-size: .82rem; font-weight: 700; text-decoration: none; padding: 10px 12px; border: 1px solid color-mix(in srgb, var(--brand) 35%, transparent); background: var(--brand-softer); border-radius: 10px; }
  .side-dl svg { width: 18px; height: 18px; flex: none; }

  .dl-panel { display: flex; gap: 16px; align-items: center; padding: 18px 20px; margin-bottom: 28px; background: var(--surface); border: 1px solid var(--line); border-left: 5px solid var(--brand); border-radius: 12px; box-shadow: var(--shadow); flex-wrap: wrap; }
  .dl-icon svg { width: 44px; height: 44px; display: block; }
  .dl-text { flex: 1 1 260px; display: flex; flex-direction: column; line-height: 1.65; }
  .dl-text span { font-size: .86rem; color: var(--muted); }
  .dl-panel .btn { font-size: .84rem; max-width: 100%; overflow: hidden; text-overflow: ellipsis; }

  .toc-inline { display: none; background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 12px 16px; margin-bottom: 20px; }
  .toc-inline summary { cursor: pointer; font-weight: 700; }
  .toc-inline ol { margin-top: 10px; }

  .verify-box { margin-top: 48px; padding: 20px 22px; border-radius: 12px; background: var(--brand-softer); border: 1px solid color-mix(in srgb, var(--brand) 25%, transparent); }
  .verify-box h2, .sources h2 { font-size: 1rem; margin: 0 0 8px; }
  .verify-box p { margin: .4em 0; font-size: .9rem; }
  .sources { margin-top: 28px; }
  .sources ul { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 6px; }
  .sources a { display: block; font-size: .8rem; color: var(--muted); text-decoration: none; padding: 8px 12px; background: var(--surface); border: 1px solid var(--line); border-radius: 8px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .sources a:hover { border-color: var(--brand); color: var(--brand); }
  .src-host { font-weight: 700; color: var(--text); margin-right: 10px; }

  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 36px; }
  .pager a { display: flex; flex-direction: column; gap: 4px; padding: 14px 16px; background: var(--surface); border: 1px solid var(--line); border-radius: 12px; text-decoration: none; color: var(--text); font-size: .88rem; line-height: 1.6; font-weight: 600; }
  .pager a:hover { border-color: var(--brand); }
  .pager small { color: var(--faint); font-weight: 500; font-size: .76rem; }
  .pager .next { text-align: right; }

  @media (max-width: 960px) {
    .post-grid { grid-template-columns: 1fr; gap: 0; }
    .toc-side { display: none; }
    .toc-inline { display: block; }
    .post-main { max-width: none; }
  }
  @media (max-width: 560px) { .pager { grid-template-columns: 1fr; } .pager .next { text-align: left; } }
</style>
