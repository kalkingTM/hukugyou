---
import Base from '../../layouts/Base.astro';
import PostRow from '../../components/PostRow.astro';
import { getCollection, render } from 'astro:content';
import { statSync } from 'node:fs';
import { SITE, catOf, fmtDate, url } from '../../site';

export async function getStaticPaths() {
  const posts = (await getCollection('posts')).sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf() || a.id.localeCompare(b.id));
  return posts.map((p, i) => ({
    params: { slug: p.id },
    props: { post: p, prev: posts[i - 1] ?? null, next: posts[i + 1] ?? null, all: posts },
  }));
}
const { post, prev, next, all } = Astro.props;
const { Content, headings } = await render(post);
const d = post.data;
const cat = catOf(d.category);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const related = [
  ...all.filter((p) => p.id !== post.id && p.data.category === d.category),
  ...all.filter((p) => p.id !== post.id && p.data.category !== d.category),
].slice(0, 3);

let fileSize = '';
if (d.sampleFile) {
  try {
    const kb = statSync(new URL(`../../../public/files/${d.sampleFile}`, import.meta.url)).size / 1024;
    fileSize = `${Math.max(1, Math.round(kb))} KB`;
  } catch { /* サイズが取れなくても表示は続ける */ }
}

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: d.title,
  description: d.description,
  datePublished: d.date.toISOString(),
  dateModified: d.date.toISOString(),
  inLanguage: 'ja',
  mainEntityOfPage: pageUrl,
  author: { '@type': 'Organization', name: SITE.name, url: new URL(url('about/'), Astro.site).href },
  publisher: { '@type': 'Organization', name: SITE.name },
  keywords: d.keyword,
};
const crumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: SITE.name, item: new URL(url('/'), Astro.site).href },
    { '@type': 'ListItem', position: 2, name: d.category, item: new URL(url(`category/${cat.slug}/`), Astro.site).href },
    { '@type': 'ListItem', position: 3, name: d.title },
  ],
};
const host = (s: string) => { try { return new URL(s).hostname.replace(/^www\d*\./, ''); } catch { return s; } };
const label = (s: string) => { try { return decodeURIComponent(new URL(s).pathname).replace(/^\/(ja-jp\/)?/, '').slice(0, 70); } catch { return s; } };
---
<Base title={d.title} description={d.description} ogType="article" jsonld={[articleLd, crumbLd]}>
  <div class="progress" aria-hidden="true"><i></i></div>
  <div class="wrap">
    <header class="post-head">
      <nav class="crumbs" aria-label="パンくずリスト">
        <a href={url('/')}>ホーム</a><span aria-hidden="true">/</span><a href={url(`category/${cat.slug}/`)}>{d.category}</a>
      </nav>
      <h1>{d.title}</h1>
      <p class="lead">{d.description}</p>
      <p class="byline">
        <time datetime={d.date.toISOString()}>{fmtDate(d.date)}</time>
        <span>{d.category}</span>
        {d.hasAffiliate && <span class="pr">PR</span>}
      </p>
    </header>

    <div class="post-grid">
      <aside class="toc-side" aria-label="目次">
        {toc.length > 0 && (
          <nav class="toc">
            <p class="toc-title">目次</p>
            <ol>{toc.map((h) => <li class={`d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
          </nav>
        )}
      </aside>

      <article class="post-main">
        {d.sampleFile && (
          <div class="file-row">
            <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M7 3h13l6 6v20H7z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /><path d="M20 3v6h6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /><path d="M11.5 14.5l7 8M18.5 14.5l-7 8" stroke="#1a6a43" stroke-width="2.2" stroke-linecap="round" /></svg>
            <div class="file-info">
              <span class="file-label">見本ファイル</span>
              <span class="file-name">{d.sampleFile}{fileSize && <small>{fileSize}</small>}</span>
            </div>
            <a class="btn" href={url(`files/${d.sampleFile}`)} download>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12M7 10l5 5 5-5M4 20h16" /></svg>
              ダウンロード
            </a>
          </div>
        )}

        {toc.length > 0 && (
          <details class="toc-inline">
            <summary>目次（{toc.filter((h) => h.depth === 2).length}項目）</summary>
            <ol>{toc.map((h) => <li class={`d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
          </details>
        )}

        <div class="prose"><Content /></div>

        <section class="post-foot">
          <h2>この記事の確認方法</h2>
          <p>紹介した数式は見本ファイルに入れて計算し、記事中の結果と一致することを確認してから掲載しています。お使いのExcelのバージョンで使えない関数がある場合は、本文の代わりの数式をお試しください。誤りに気づいたら<a href={url('contact/')}>お問い合わせ</a>からお知らせください。</p>
          <h2>参考にした情報</h2>
          <ul class="sources">
            {d.sources.map((s) => (
              <li><a href={s} rel="nofollow noopener" target="_blank"><b>{host(s)}</b><span>{label(s)}</span></a></li>
            ))}
          </ul>
        </section>

        <nav class="pager" aria-label="前後の記事">
          {prev ? <a class="prev" href={url(`posts/${prev.id}/`)}><small>前の記事</small>{prev.data.title}</a> : <span></span>}
          {next ? <a class="next" href={url(`posts/${next.id}/`)}><small>次の記事</small>{next.data.title}</a> : <span></span>}
        </nav>
      </article>
    </div>

    {related.length > 0 && (
      <section class="related" aria-labelledby="rel">
        <h2 id="rel">ほかの記事</h2>
        <ul class="list">{related.map((p) => <PostRow post={p} />)}</ul>
      </section>
    )}
  </div>

  <script is:inline>
    (function () {
      // 数式ブロックにコピーボタン
      document.querySelectorAll('.prose pre').forEach(function (pre) {
        var b = document.createElement('button');
        b.type = 'button'; b.className = 'copy-btn'; b.textContent = 'コピー';
        b.setAttribute('aria-label', 'この数式をコピー');
        b.addEventListener('click', function () {
          var code = pre.querySelector('code');
          var text = (code ? code.innerText : pre.innerText).trim();
          var done = function (msg, ok) {
            b.textContent = msg; if (ok) b.classList.add('done');
            setTimeout(function () { b.textContent = 'コピー'; b.classList.remove('done'); }, 1800);
          };
          if (navigator.clipboard) navigator.clipboard.writeText(text).then(function () { done('コピーしました', true); }, function () { done('選択してコピー', false); });
          else done('選択してコピー', false);
        });
        pre.appendChild(b);
      });
      // 読み進み表示
      var bar = document.querySelector('.progress i');
      var main = document.querySelector('.post-main');
      function onScroll() {
        if (!bar || !main) return;
        var r = main.getBoundingClientRect();
        var total = r.height - window.innerHeight * 0.6;
        var p = Math.min(1, Math.max(0, (-r.top + 80) / Math.max(total, 1)));
        bar.style.transform = 'scaleX(' + p + ')';
      }
      window.addEventListener('scroll', onScroll, { passive: true }); onScroll();
      // 目次の現在位置
      var links = Array.prototype.slice.call(document.querySelectorAll('.toc-side .toc a'));
      if (links.length && 'IntersectionObserver' in window) {
        var map = {};
        links.forEach(function (a) { map[decodeURIComponent(a.hash.slice(1))] = a; });
        var io = new IntersectionObserver(function (es) {
          es.forEach(function (e) {
            if (e.isIntersecting && map[e.target.id]) {
              links.forEach(function (l) { l.classList.remove('on'); });
              map[e.target.id].classList.add('on');
            }
          });
        }, { rootMargin: '-90px 0px -72% 0px' });
        document.querySelectorAll('.prose h2[id], .prose h3[id]').forEach(function (h) { io.observe(h); });
      }
    })();
  </script>
</Base>

<style>
  .progress { position: fixed; top: 0; left: 0; right: 0; height: 3px; z-index: 40; pointer-events: none; }
  .progress i { display: block; height: 100%; background: var(--brand); transform: scaleX(0); transform-origin: 0 50%; }

  .post-head { max-width: var(--measure); padding: 44px 0 8px; margin-left: calc(15rem + 56px); }
  h1 { font-size: clamp(1.55rem, 3.4vw, 2.1rem); line-height: 1.5; margin: 0 0 16px; letter-spacing: .02em; }
  .lead { margin: 0 0 18px; color: var(--muted); font-size: 1rem; line-height: 1.85; }
  .byline { display: flex; flex-wrap: wrap; gap: 4px 16px; align-items: center; margin: 0; font-size: .84rem; color: var(--faint); }
  .byline time { font-family: var(--mono); letter-spacing: 0; }

  .post-grid { display: grid; grid-template-columns: 15rem minmax(0, var(--measure)); gap: 56px; margin-top: 36px; align-items: start; }
  .post-main { min-width: 0; }

  .toc-side { position: sticky; top: 84px; max-height: calc(100vh - 104px); overflow-y: auto; scrollbar-width: thin; }
  .toc { font-size: .84rem; }
  .toc-title { margin: 0 0 10px; font-size: .72rem; font-weight: 700; letter-spacing: .14em; color: var(--faint); }
  .toc ol, .toc-inline ol { list-style: none; margin: 0; padding: 0; }
  .toc li a { display: block; padding: 6px 0 6px 14px; border-left: 2px solid var(--line); color: var(--muted); text-decoration: none; line-height: 1.55; }
  .toc li.d3 a { padding-left: 28px; font-size: .8rem; }
  .toc li a:hover { color: var(--text); border-left-color: var(--line-strong); }
  .toc li a.on { color: var(--brand); border-left-color: var(--brand); font-weight: 700; }

  .file-row { display: flex; align-items: center; gap: 16px; padding: 16px 18px; margin-bottom: 32px; border: 1px solid var(--line-strong); border-radius: 8px; background: var(--surface); flex-wrap: wrap; }
  .file-row > svg { width: 34px; height: 34px; flex: none; color: var(--muted); }
  .file-info { display: flex; flex-direction: column; flex: 1 1 200px; min-width: 0; line-height: 1.5; }
  .file-label { font-size: .74rem; color: var(--faint); letter-spacing: .08em; }
  .file-name { font-family: var(--mono); font-size: .86rem; overflow-wrap: anywhere; }
  .file-name small { margin-left: 10px; color: var(--faint); font-size: .74rem; }

  .toc-inline { display: none; margin-bottom: 28px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); }
  .toc-inline summary { cursor: pointer; padding: 13px 16px; font-weight: 700; font-size: .92rem; min-height: 44px; }
  .toc-inline ol { padding: 0 16px 12px; }
  .toc-inline li a { display: block; padding: 8px 0; font-size: .9rem; color: var(--text); text-decoration: none; border-top: 1px solid var(--line); }
  .toc-inline li.d3 a { padding-left: 16px; color: var(--muted); font-size: .86rem; }

  .post-foot { margin-top: 64px; padding-top: 28px; border-top: 1px solid var(--text); }
  .post-foot h2 { font-size: 1rem; margin: 0 0 8px; }
  .post-foot p { margin: 0 0 28px; font-size: .9rem; color: var(--muted); }
  .sources { list-style: none; margin: 0; padding: 0; }
  .sources li { border-bottom: 1px solid var(--line); }
  .sources a { display: flex; gap: 14px; align-items: baseline; padding: 10px 0; font-size: .82rem; color: var(--muted); text-decoration: none; min-width: 0; }
  .sources a:hover { color: var(--brand); }
  .sources b { flex: none; color: var(--text); font-weight: 700; }
  .sources span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }

  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 40px; }
  .pager a { display: flex; flex-direction: column; gap: 4px; padding: 14px 16px; border: 1px solid var(--line-strong); border-radius: 8px; text-decoration: none; color: var(--text); font-size: .9rem; line-height: 1.6; font-weight: 700; background: var(--surface); }
  .pager a:hover { border-color: var(--brand); background: var(--brand-wash); }
  .pager small { color: var(--faint); font-weight: 500; font-size: .74rem; letter-spacing: .08em; }
  .pager .next { text-align: right; }

  .related { margin-top: 72px; }
  .related h2 { font-size: 1.1rem; margin: 0 0 14px; }

  @media (max-width: 1000px) {
    .post-head { margin-left: 0; }
    .post-grid { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .toc-side { display: none; }
    .toc-inline { display: block; }
  }
  @media (max-width: 560px) {
    .post-head { padding-top: 28px; }
    .prose { font-size: 1.02rem; }
    .pager { grid-template-columns: 1fr; }
    .pager .next { text-align: left; }
    .file-row .btn { width: 100%; justify-content: center; }
    .sources a { flex-direction: column; align-items: stretch; gap: 0; }
  }
</style>
