---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES, SITE, url } from '../../site';

export function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { slug: c.slug }, props: { cat: c } }));
}
const { cat } = Astro.props;
const posts = (await getCollection('posts'))
  .filter((p) => p.data.category === cat.name)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const crumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: SITE.name, item: new URL(url('/'), Astro.site).href },
    { '@type': 'ListItem', position: 2, name: cat.name },
  ],
};
---
<Base title={`${cat.name}のExcelレシピ`} description={cat.lead} jsonld={[crumbs]}>
  <div class="wrap">
    <header class="page-head" style={`--cat:${cat.color}`}>
      <nav class="crumbs" aria-label="パンくずリスト"><a href={url('/')}>ホーム</a><span>/</span>{cat.name}</nav>
      <span class="chip">{cat.name}</span>
      <h1>{cat.name}のExcelレシピ</h1>
      <p class="meta">{cat.lead}。全{posts.length}本。</p>
    </header>
    {posts.length === 0
      ? <p class="empty">このカテゴリのレシピは準備中です。毎日1本ずつ追加しています。</p>
      : <div class="cards">{posts.map((p) => <PostCard post={p} />)}</div>}
  </div>
</Base>
<style>
  .crumbs { font-size: .8rem; color: var(--faint); margin-bottom: 14px; display: flex; gap: 8px; }
  .crumbs a { color: var(--muted); text-decoration: none; }
  .page-head { margin-bottom: 18px; }
  .page-head h1 { margin-top: 10px; }
</style>
