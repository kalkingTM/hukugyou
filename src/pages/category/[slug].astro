---
import Base from '../../layouts/Base.astro';
import PostRow from '../../components/PostRow.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES, SITE, url } from '../../site';

export function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { slug: c.slug }, props: { cat: c } }));
}
const { cat } = Astro.props;
const posts = (await getCollection('posts'))
  .filter((p) => p.data.category === cat.name)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf() || b.id.localeCompare(a.id));
const crumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: SITE.name, item: new URL(url('/'), Astro.site).href },
    { '@type': 'ListItem', position: 2, name: cat.name },
  ],
};
---
<Base title={`${cat.name}のExcelレシピ`} description={`${cat.lead}に関するExcelの記事一覧です。`} jsonld={[crumbs]}>
  <div class="wrap">
    <header class="page-head">
      <nav class="crumbs" aria-label="パンくずリスト"><a href={url('/')}>ホーム</a><span aria-hidden="true">/</span><span>{cat.name}</span></nav>
      <h1>{cat.name}</h1>
      <p class="meta">{cat.lead}。{posts.length}件</p>
    </header>
    {posts.length === 0
      ? <p class="empty">このカテゴリの記事は準備中です。毎日1本ずつ追加しています。</p>
      : <ul class="list" style="margin-top:24px">{posts.map((p) => <PostRow post={p} />)}</ul>}
  </div>
</Base>
