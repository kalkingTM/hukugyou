---
import Base from '../layouts/Base.astro';
import PostRow from '../components/PostRow.astro';
import { getCollection } from 'astro:content';
import { SITE, CATEGORIES, url } from '../site';
const posts = (await getCollection('posts')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf() || b.id.localeCompare(a.id));
const count = (name: string) => posts.filter((p) => p.data.category === name).length;
---
<Base>
  <div class="wrap">
    <section class="intro">
      <h1>会社で使うExcelの困りごとを、<br class="br-pc" />1記事1問題で解決します。</h1>
      <p>
        すべての記事に、数式が入った見本ファイル（.xlsx）が付いています。
        掲載前に数式を計算し直して、記事に書いた結果と合っているかを確認しています。
      </p>

      <form class="search" role="search" onsubmit="return false">
        <label class="sr-only" for="q">記事を検索</label>
        <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M13 13l4.5 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
        <input id="q" type="search" placeholder="例：土日 色分け　重複　請求書" autocomplete="off" enterkeyhint="search" />
        <kbd aria-hidden="true">/</kbd>
      </form>

      <nav class="cat-tabs" aria-label="カテゴリで絞り込む">
        <a href={url('/')} aria-current="page">すべて<span>{posts.length}</span></a>
        {CATEGORIES.map((c) => <a href={url(`category/${c.slug}/`)}>{c.name}<span>{count(c.name)}</span></a>)}
      </nav>
    </section>

    <section aria-labelledby="latest">
      <div class="list-head">
        <h2 id="latest">記事一覧</h2>
        <p id="result" class="meta" aria-live="polite">{posts.length}件</p>
      </div>
      {posts.length === 0 ? <p class="empty">最初の記事を準備中です。</p> : (
        <ul class="list" id="list">{posts.map((p) => <PostRow post={p} />)}</ul>
      )}
      <p id="none" class="empty" hidden>該当する記事がありません。別の言葉でお試しください。</p>
    </section>

    <aside class="note">
      <h2>このサイトについて</h2>
      <p>記事はAI（Claude）を使って作成しています。数式は見本ファイルに入れて実際に計算し、記事の値と一致したものだけを掲載しています。詳しくは<a href={url('about/')}>記事の作り方</a>をご覧ください。</p>
    </aside>
  </div>

  <script is:inline>
    (function () {
      var q = document.getElementById('q');
      var rows = Array.prototype.slice.call(document.querySelectorAll('#list .row'));
      var result = document.getElementById('result');
      var none = document.getElementById('none');
      if (!q || !rows.length) return;
      var norm = function (s) { return String(s).normalize('NFKC').toLowerCase(); };
      var data = rows.map(function (r) { return norm(r.getAttribute('data-search')); });
      function run() {
        var terms = norm(q.value).split(/\s+/).filter(Boolean);
        var n = 0;
        rows.forEach(function (r, i) {
          var ok = terms.every(function (t) { return data[i].indexOf(t) !== -1; });
          r.hidden = !ok;
          if (ok) n++;
        });
        result.textContent = (terms.length ? '検索結果 ' : '') + n + '件';
        none.hidden = n !== 0;
      }
      q.addEventListener('input', run);
      document.addEventListener('keydown', function (e) {
        if (e.key === '/' && document.activeElement !== q && !/^(INPUT|TEXTAREA)$/.test(document.activeElement.tagName)) {
          e.preventDefault(); q.focus();
        }
        if (e.key === 'Escape' && document.activeElement === q) { q.value = ''; run(); q.blur(); }
      });
    })();
  </script>
</Base>

<style>
  .intro { padding: 72px 0 40px; max-width: 46rem; }
  h1 { font-size: clamp(1.7rem, 4.2vw, 2.35rem); line-height: 1.5; margin: 0 0 20px; letter-spacing: .02em; font-weight: 700; }
  .intro > p { margin: 0 0 32px; color: var(--muted); font-size: 1rem; max-width: 40rem; }
  .search { position: relative; margin-bottom: 20px; }
  .search svg { position: absolute; left: 16px; top: 50%; width: 19px; height: 19px; margin-top: -9.5px; color: var(--faint); pointer-events: none; }
  .search input { width: 100%; height: 54px; padding: 0 48px 0 46px; font: inherit; font-size: 1rem; color: var(--text); background: var(--surface); border: 1px solid var(--line-strong); border-radius: 8px; appearance: none; -webkit-appearance: none; }
  .search input::placeholder { color: var(--faint); }
  .search input:focus { outline: 2px solid var(--brand); outline-offset: 1px; border-color: var(--brand); }
  .search kbd { position: absolute; right: 14px; top: 50%; transform: translateY(-50%); font: 600 .72rem var(--mono); color: var(--faint); border: 1px solid var(--line-strong); border-radius: 4px; padding: 1px 7px; background: var(--sunken); }
  .cat-tabs { display: flex; flex-wrap: wrap; gap: 8px; }
  .cat-tabs a { display: inline-flex; align-items: center; gap: 8px; min-height: 40px; padding: 0 14px; border: 1px solid var(--line-strong); border-radius: 999px; color: var(--text); text-decoration: none; font-size: .88rem; background: var(--surface); }
  .cat-tabs a:hover { border-color: var(--brand); color: var(--brand); }
  .cat-tabs a[aria-current="page"] { background: var(--text); color: var(--bg); border-color: var(--text); font-weight: 700; }
  .cat-tabs span { font-size: .76rem; color: var(--faint); font-variant-numeric: tabular-nums; }
  .cat-tabs a[aria-current="page"] span { color: color-mix(in srgb, var(--bg) 70%, transparent); }
  .list-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin: 16px 0 14px; }
  .list-head h2 { margin: 0; font-size: 1.15rem; }
  .list-head p { margin: 0; }
  .note { margin-top: 72px; padding: 28px 0 0; border-top: 1px solid var(--line); max-width: 46rem; }
  .note h2 { font-size: 1rem; margin: 0 0 8px; }
  .note p { margin: 0; color: var(--muted); font-size: .92rem; }
  @media (max-width: 720px) { .intro { padding: 44px 0 28px; } .br-pc { display: none; } .search input { height: 52px; } .search kbd { display: none; } }
</style>
