---
import type { CollectionEntry } from 'astro:content';
import { catOf, fmtDate, url } from '../site';
interface Props { post: CollectionEntry<'posts'>; }
const { post } = Astro.props;
const d = post.data;
const cat = catOf(d.category);
// 本文のコードブロック内の数式から、代表的なもの（関数を含み、長すぎないうち最も長い）をサムネイルに使う
const formulas = [...(post.body ?? '').matchAll(/```[^\n]*\n([\s\S]*?)```/g)]
  .flatMap((m) => m[1].split('\n'))
  .map((l) => l.replace(/^[^=]*?(?==)/, '').trim())
  .filter((l) => /^=.*[A-Z]+\(/.test(l));
const formula = formulas.filter((f) => f.length <= 64).sort((a, b) => b.length - a.length)[0] ?? formulas[0] ?? '=SUM(…)';
---
<article class="card" style={`--cat:${cat.color}`}>
  <div class="card-thumb" aria-hidden="true">
    <span class="cell"></span>
    <span class="formula"><span class="fx">fx</span>{formula}</span>
  </div>
  <div class="card-body">
    <div class="card-meta">
      <span class="chip">{d.category}</span>
      {d.sampleFile && (
        <span class="badge" title="数式入りの見本ファイルをダウンロードできます">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v8M4.5 6.5 8 10l3.5-3.5M3 13h10" /></svg>見本xlsx
        </span>
      )}
      {d.hasAffiliate && <span class="pr">PR</span>}
    </div>
    <h3><a href={url(`posts/${post.id}/`)}>{d.title}</a></h3>
    <p>{d.description}</p>
    <time datetime={d.date.toISOString()}>{fmtDate(d.date)}</time>
  </div>
</article>
