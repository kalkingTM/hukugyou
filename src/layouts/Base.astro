---
import '../styles/global.css';
import { SITE, CATEGORIES, VERIFY, url } from '../site';
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  jsonld?: object[];
}
const { title, description = SITE.description, noindex = false, ogType = 'website', jsonld = [] } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name}｜${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url('og.png'), Astro.site);
const path = Astro.url.pathname;
const siteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: new URL(url('/'), Astro.site).href,
  description: SITE.description,
  inLanguage: 'ja',
};
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex
      ? <meta name="robots" content="noindex, nofollow" />
      : <>
          <link rel="canonical" href={canonical} />
          <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
        </>}
    {VERIFY.google && <meta name="google-site-verification" content={VERIFY.google} />}
    {VERIFY.bing && <meta name="msvalidate.01" content={VERIFY.bing} />}
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href={url('rss.xml')} />
    <link rel="sitemap" type="application/xml" href={url('sitemap.xml')} />
    <meta name="theme-color" content="#fbfbf9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131513" media="(prefers-color-scheme: dark)" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet" />
    {[siteLd, ...jsonld].map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    <a class="skip" href="#main">本文へ移動</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={url('/')}>
          <svg class="brand-mark" viewBox="0 0 22 22" aria-hidden="true">
            <rect x="1" y="1" width="20" height="20" rx="3" fill="none" stroke="currentColor" stroke-width="1.6" />
            <path d="M1 8h20M1 14h20M8 1v20" stroke="currentColor" stroke-width="1.2" opacity=".5" />
            <rect x="8" y="8" width="13" height="6" fill="#1a6a43" />
          </svg>
          {SITE.name}
        </a>
        <nav class="nav" aria-label="カテゴリ">
          {CATEGORIES.map((c) => (
            <a href={url(`category/${c.slug}/`)} aria-current={path.startsWith(url(`category/${c.slug}/`)) ? 'page' : undefined}>{c.name}</a>
          ))}
        </nav>
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="about-col">
          <h2>{SITE.name}</h2>
          <p>{SITE.description}</p>
          <p>当サイトはアフィリエイトプログラムに参加しており、記事内の一部のリンクから収益を得ることがあります。該当する記事には「PR」と表示しています。</p>
        </div>
        <div>
          <h2>カテゴリ</h2>
          <ul>{CATEGORIES.map((c) => <li><a href={url(`category/${c.slug}/`)}>{c.name}</a></li>)}</ul>
        </div>
        <div>
          <h2>サイトについて</h2>
          <ul>
            <li><a href={url('about/')}>運営者情報・記事の作り方</a></li>
            <li><a href={url('privacy/')}>プライバシーポリシー・免責事項</a></li>
            <li><a href={url('contact/')}>お問い合わせ</a></li>
          </ul>
        </div>
        <p class="copy">© {new Date().getFullYear()} {SITE.name}</p>
      </div>
    </footer>
  </body>
</html>
